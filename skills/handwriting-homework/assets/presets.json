{
  "_说明": [
    "字体预设：一套「字体 + 排版手感」的组合，用 --preset 名字 直接套用。",
    "font_file 会在系统字体目录里按文件名查找（含 AssetsV2 按需下载的字体），所以路径变了也不怕。",
    "ttf 用于指向自己生成的字体（相对作业目录的路径）。",
    "命令行给出的参数优先级最高，会覆盖预设里的同名项。"
  ],
  "presets": {
    "娃娃体": {
      "font_file": "WawaSC-Regular.otf",
      "font_index": 0,
      "label": "娃娃体 Wawati SC",
      "chars_per_line": 26,
      "line_spacing": 1.62,
      "rules": "line",
      "jitter": "mid",
      "paper_style": "paper",
      "ink_color": "32,32,44",
      "ink_alpha": 0.92,
      "note": "圆胖可爱，偏低龄；写得慢、间距大一点更像"
    },
    "翩翩体": {
      "font_file": "Hanzipen.ttc",
